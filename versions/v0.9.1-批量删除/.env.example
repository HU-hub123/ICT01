# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，勿提交）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 后续接入华为云 ModelArts 推理端点时，只需修改 BASE_URL / MODEL / KEY
# DEEPSEEK_BASE_URL=https://your-modelarts-endpoint/v1

# ---------- 存储（认知账本） ----------
# file（默认，本地 JSON）| postgres（华为云 RDS / 自建 Postgres）
LEDGER_STORE=file
# LEDGER_STORE=postgres 时必填：
# RDS_CONNECTION_STRING=postgres://user:password@host:5432/cognitive_scaffold

# ---------- 限流（每个 IP 每小时的推演次数） ----------
# 未配置 REDIS_URL 时自动降级为进程内存
RATE_LIMIT_PER_HOUR=30
# REDIS_URL=redis://host:6379
